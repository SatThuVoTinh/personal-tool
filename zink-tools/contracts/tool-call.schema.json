{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zink.local/contracts/tool-call.schema.json",
  "title": "Zink Tool Call Envelope Schema",
  "x-zink-contract-version": "1.1.0",
  "$defs": {
    "uuid_v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "json_value": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/json_value" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json_value" }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        }
      },
      "additionalProperties": false
    },
    "sql_provenance": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "session_key": { "type": "string", "minLength": 1 }
      },
      "required": ["task_id", "session_key"],
      "additionalProperties": false
    },
    "delegated_provenance": {
      "type": "object",
      "properties": {
        "delegation_id": { "$ref": "#/$defs/uuid_v4" },
        "task_id": { "type": "string", "minLength": 1 },
        "session_key": { "type": "string", "minLength": 1 }
      },
      "required": ["delegation_id", "task_id", "session_key"],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "call_id": { "$ref": "#/$defs/uuid_v4" },
        "specialist": {
          "type": "string",
          "enum": ["sql"]
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "tool_id": { "const": "zink_sql" },
        "input": { "$ref": "tools/zink-sql.schema.json#/$defs/input" },
        "provenance": { "$ref": "#/$defs/sql_provenance" }
      },
      "required": ["call_id", "specialist", "constraints", "tool_id", "input", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "call_id": { "$ref": "#/$defs/uuid_v4" },
        "specialist": {
          "type": "string",
          "enum": ["excel"]
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "tool_id": { "const": "zink_excel" },
        "input": { "$ref": "tools/zink-excel.schema.json#/$defs/input" },
        "provenance": { "$ref": "#/$defs/delegated_provenance" },
        "approval_id": { "$ref": "#/$defs/uuid_v4" }
      },
      "required": ["call_id", "specialist", "constraints", "tool_id", "input", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "call_id": { "$ref": "#/$defs/uuid_v4" },
        "specialist": {
          "type": "string",
          "enum": ["power-bi"]
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "tool_id": { "const": "zink_power_bi" },
        "input": { "$ref": "tools/zink-power-bi.schema.json#/$defs/input" },
        "provenance": { "$ref": "#/$defs/delegated_provenance" },
        "approval_id": { "$ref": "#/$defs/uuid_v4" }
      },
      "required": ["call_id", "specialist", "constraints", "tool_id", "input", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "call_id": { "$ref": "#/$defs/uuid_v4" },
        "specialist": {
          "type": "string",
          "enum": ["python"]
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "tool_id": { "const": "zink_python" },
        "input": { "$ref": "tools/zink-python.schema.json#/$defs/input" },
        "provenance": { "$ref": "#/$defs/delegated_provenance" },
        "approval_id": { "$ref": "#/$defs/uuid_v4" }
      },
      "required": ["call_id", "specialist", "constraints", "tool_id", "input", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "call_id": { "$ref": "#/$defs/uuid_v4" },
        "specialist": {
          "type": "string",
          "enum": ["o2", "python"]
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "tool_id": { "const": "zink_n8n" },
        "input": { "$ref": "tools/zink-n8n.schema.json#/$defs/input" },
        "provenance": { "$ref": "#/$defs/delegated_provenance" },
        "approval_id": { "$ref": "#/$defs/uuid_v4" }
      },
      "required": ["call_id", "specialist", "constraints", "tool_id", "input", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "call_id": { "$ref": "#/$defs/uuid_v4" },
        "specialist": {
          "type": "string",
          "enum": ["main", "o1", "o2", "excel", "power-bi", "sql", "python"]
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "tool_id": { "const": "zink_skill_search" },
        "input": { "$ref": "tools/zink-skill.schema.json#/$defs/input" },
        "provenance": { "$ref": "#/$defs/sql_provenance" }
      },
      "required": ["call_id", "specialist", "constraints", "tool_id", "input", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "call_id": { "$ref": "#/$defs/uuid_v4" },
        "specialist": {
          "type": "string",
          "enum": ["main", "o1", "o2", "excel", "power-bi", "sql", "python"]
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "tool_id": { "const": "zink_knowledge_search" },
        "input": { "$ref": "tools/zink-knowledge.schema.json#/$defs/input" },
        "provenance": { "$ref": "#/$defs/sql_provenance" }
      },
      "required": ["call_id", "specialist", "constraints", "tool_id", "input", "provenance"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "call_id": { "$ref": "#/$defs/uuid_v4" },
        "specialist": {
          "type": "string",
          "enum": ["excel", "power-bi", "sql", "python"]
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "tool_id": { "const": "zink_skill_propose" },
        "input": { "$ref": "tools/zink-skill.schema.json#/$defs/input" },
        "provenance": { "$ref": "#/$defs/delegated_provenance" }
      },
      "required": ["call_id", "specialist", "constraints", "tool_id", "input", "provenance"],
      "additionalProperties": false
    }
  ]
}
