{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zink.local/contracts/tools/zink-knowledge.schema.json",
  "title": "Zink Knowledge Tool Schema",
  "x-zink-contract-version": "1.1.0",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["search", "retrieve", "citation", "metadata"]
        },
        "namespace": {
          "type": "string",
          "enum": [
            "core",
            "governance",
            "supply-chain",
            "logistics",
            "finance",
            "data-engineering",
            "analytics",
            "sql",
            "bi-semantic",
            "excel",
            "statistics",
            "machine-learning",
            "optimization",
            "operations-research",
            "simulation",
            "research",
            "architecture"
          ]
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "chunk_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,128}$"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results (1-20)"
        },
        "primary_topic": {
          "type": "string",
          "description": "Optional primary topic filter"
        },
        "path_prefix": {
          "type": "string",
          "description": "Optional path prefix filter"
        },
        "rerank": {
          "type": "boolean",
          "description": "Optional deep cross-encoder reranking"
        }
      },
      "required": ["action", "namespace"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "semantic_contract_version": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chunk_id": { "type": "string" },
              "title": { "type": "string" },
              "text": { "type": "string" },
              "score": { "type": "number" },
              "citation": { "type": "string" },
              "metadata": {
                "type": "object",
                "properties": {
                  "source_path": { "type": "string" },
                  "heading_path": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "source_type": { "type": "string" },
                  "source_id": { "type": ["string", "null"] },
                  "source_sha256": {
                    "type": ["string", "null"],
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "line_start": { "type": ["number", "null"] },
                  "line_end": { "type": ["number", "null"] },
                  "page_start": { "type": ["number", "null"] },
                  "page_end": { "type": ["number", "null"] }
                },
                "additionalProperties": false
              }
            },
            "required": ["chunk_id", "text"],
            "additionalProperties": false
          }
        },
        "total_count": {
          "type": "integer",
          "minimum": 0
        },
        "governed_status": {
          "type": "string",
          "enum": ["SUCCESS", "NO_MATCH", "CONTROLLED_FAILURE"]
        },
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["action", "namespace", "results", "total_count", "governed_status"],
      "additionalProperties": false
    }
  }
}
