{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zink.local/contracts/tools/zink-forecast.schema.json",
  "title": "Zink Forecast Schema-Only Specification",
  "x-zink-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "problem_type": {
      "type": "string",
      "enum": ["univariate_time_series", "multivariate_time_series", "hierarchical_time_series"]
    },
    "horizon": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "granularity": {
      "type": "string",
      "enum": ["hourly", "daily", "weekly", "monthly"]
    },
    "target_series": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "exogenous_features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["problem_type", "horizon", "granularity", "target_series"]
}
