{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zink.local/contracts/tools/zink-skill.schema.json",
  "title": "Zink Skill Tool Schema",
  "x-zink-contract-version": "1.1.0",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["discover", "read", "validate", "apply", "search", "propose"]
        },
        "namespace": {
          "type": ["string", "array"]
        },
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,128}$"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "primary_topic": {
          "type": "string"
        },
        "subtopic": {
          "type": "string"
        },
        "secondary_topics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "content": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "requesting_agent": {
          "type": "string"
        }
      },
      "required": ["action"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "namespace": {
          "type": ["string", "array"]
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skill_id": { "type": "string" },
              "name": { "type": "string" },
              "namespace": { "type": "string" },
              "lifecycle_state": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["skill_id", "namespace", "lifecycle_state"],
            "additionalProperties": false
          }
        },
        "skill_content": {
          "type": "object",
          "properties": {
            "skill_id": { "type": "string" },
            "lifecycle_state": { "type": "string" },
            "content": { "type": "string" },
            "signature": { "type": "string" }
          },
          "additionalProperties": true
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skill_id": { "type": "string" },
              "namespace": { "type": ["string", "array"] },
              "capability": { "type": "string" },
              "version": { "type": "string" },
              "domain": { "type": "string" },
              "primary_topic": { "type": "string" },
              "subtopic": { "type": ["string", "null"] },
              "content": { "type": "string" },
              "score": { "type": "number" },
              "provenance": { "type": "object" }
            },
            "required": ["capability", "version", "content"],
            "additionalProperties": true
          }
        },
        "proposal": {
          "type": "object",
          "properties": {
            "proposal_id": { "type": "string" },
            "namespace": { "type": ["string", "array"] },
            "capability": { "type": "string" },
            "version": { "type": "string" },
            "content_sha256": { "type": "string" },
            "requesting_agent": { "type": "string" },
            "reason": { "type": "string" },
            "status": { "type": "string", "enum": ["CANDIDATE"] }
          },
          "required": [
            "proposal_id",
            "capability",
            "version",
            "content_sha256",
            "status"
          ],
          "additionalProperties": true
        },
        "total_count": {
          "type": "integer"
        },
        "governed_status": {
          "type": "string",
          "enum": ["SUCCESS", "NO_MATCH", "CONTROLLED_FAILURE"]
        },
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["action", "governed_status"],
      "additionalProperties": false
    }
  }
}
