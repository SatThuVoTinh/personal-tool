# Normalize text files for Windows, Linux, and WSL checkouts.
* text=auto eol=lf

# Binary assets are never line-ending normalized or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.mp4 binary
*.mov binary
*.woff binary
*.woff2 binary
