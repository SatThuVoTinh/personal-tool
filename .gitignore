# Secrets and machine-specific environment files
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
**/credentials*.json
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.license

# Runtime data and generated artifacts
# The generated-tree rules are not root-anchored: a capture under a module
# path (integrations/openclaw/backups/, apps/knowledge/logs/, ...) is the same
# kind of artifact, and a root-anchored rule left it invisible to git status
# and one "git add -A" away from history.
/backups/*
**/backups/*
!/backups/.gitkeep
/logs/*
**/logs/*
!/logs/.gitkeep
/temp/*
**/temp/*
!/temp/.gitkeep
/infrastructure/docker/volumes/**
/infrastructure/databases/**/backups/**
/experiments/**/artifacts/**
/experiments/**/results/**
*.log

# The Node suite's own JUnit report: the skip-expectation gate reads it, and
# it is a per-run artefact, never a committed file.
.skip-expectation.xml

# Python development and test output
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# JavaScript and frontend build output
node_modules/
dist/
build/
.next/
.turbo/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
*.code-workspace
.vscode/*
!.vscode/settings.json

# Local coding-agent hot state; keep the protocol tracked
.agents/states/*.md
!.agents/states/README.md

# Transient owner-approved execution contract; protocol README remains tracked
/docs/contracts/execution/ACTIVE.md

# Local scratch directory
scratch/

# Agent-tooling temp workspace cache
.qoder/
