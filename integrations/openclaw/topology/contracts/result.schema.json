{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zink://contracts/result-v1",
  "title": "ResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_version",
    "result_id",
    "task_id",
    "brief_revision",
    "workflow_status",
    "summary",
    "deliverables",
    "evidence",
    "assumptions",
    "validation",
    "limitations",
    "owner_action_required",
    "publication_status",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "governance_version": { "const": "m7-t2-r11" },
    "result_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "task_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "brief_revision": { "type": "integer", "minimum": 1, "maximum": 16 },
    "workflow_status": {
      "enum": ["COMPLETE", "PARTIAL", "BLOCKED", "FAILED", "CANCELLED"]
    },
    "summary": { "type": "string", "maxLength": 4096 },
    "deliverables": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "evidence": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "validation": { "enum": ["VALID", "INVALID", "PENDING"] },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "owner_action_required": { "type": "boolean" },
    "publication_status": { "const": "pending_owner_post" },
    "created_at": { "type": "string", "format": "date-time" },
    "implementation_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "remote_branch": { "type": "string", "maxLength": 256 },
    "remote_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
