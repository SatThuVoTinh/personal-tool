{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zink://contracts/ledger-event-v1",
  "title": "LedgerEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_version",
    "sequence",
    "type",
    "payload",
    "created_at",
    "previous_event_digest",
    "event_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "governance_version": {
      "enum": [
        "m7-t2-r12",
        "m7-t5-r13",
        "m8-t2-r9",
        "m8-t2.1-r3",
        "m8-t2.2-r4",
        "m8-t2.3-r5"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "WORKFLOW_OPENED",
        "WORKFLOW_NATIVE_ENDED",
        "WORKFLOW_BRIEF_ACTIVATED",
        "WORKFLOW_SPAWN_RESERVED",
        "WORKFLOW_SPAWN_RECEIVED",
        "WORKFLOW_RESULT_RECORDED",
        "WORKFLOW_ROOT_RESULT_RECORDED",
        "WORKFLOW_USER_RESULT_ACCEPTED",
        "WORKFLOW_USER_RESULT_REJECTED",
        "WORKFLOW_USER_RESULT_BLOCKED",
        "WORKFLOW_RESULT_REVISION_REQUESTED",
        "WORKFLOW_USER_APPROVAL_DECIDED",
        "WORKFLOW_APPROVAL_REQUESTED",
        "WORKFLOW_APPROVAL_SURFACED",
        "WORKFLOW_RESULT_SURFACED",
        "WORKFLOW_TASK_CLAIMED",
        "WORKFLOW_COORDINATOR_RUN_BOUND",
        "WORKFLOW_USER_QUESTION_RECORDED",
        "WORKFLOW_USER_ANSWER_RECORDED",
        "WORKFLOW_CANCELLED",
        "WORKFLOW_TASK_RECONCILED",
        "WORKFLOW_CONTINUATION_AUTHORIZED",
        "WORKFLOW_CONTINUATION_STARTED",
        "BUDGET_RESERVED",
        "TASK_CREATED",
        "DELEGATION_RESERVED"
      ]
    },
    "payload": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_event_digest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_NATIVE_ENDED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "native_run_id",
              "child_session_key",
              "parent_session_key",
              "outcome"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "native_run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "child_session_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "parent_session_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "outcome": {
                "enum": ["ok", "error", "timeout", "killed", "reset", "deleted"]
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_OPENED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/opened"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_BRIEF_ACTIVATED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "description": "semantic_contract_status is required on new writes (the writer always emits it) but optional for reads: briefs activated before R4 carry no status, and rejecting legitimate history makes the ledger unreadable. The reducer replays an absent status as MISSING, which authorizes nothing.",
            "additionalProperties": false,
            "required": ["task_id", "brief_revision", "nodes"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "brief_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "semantic_contract_status": {
                "$ref": "#/$defs/semantic_contract_status"
              },
              "nodes": {
                "type": "array",
                "maxItems": 72,
                "items": {
                  "$ref": "#/$defs/node"
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_SPAWN_RESERVED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/reserved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_SPAWN_RECEIVED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "delegation_id",
              "native_run_id",
              "child_session_key",
              "agent_id",
              "parent_session_key"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "delegation_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "native_run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "child_session_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "agent_id": {
                "description": "Open-world agent identity. The ledger records what executed, including ad-hoc identities outside the governed spawn topology; execution authority is enforced by the guard and reducer, not by this vocabulary. A closed enum here makes legitimate history unreadable without preventing anything.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "parent_session_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_RESULT_RECORDED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "envelope": {
                "type": "object"
              },
              "agent_id": {
                "description": "Open-world agent identity. The ledger records what executed, including ad-hoc identities outside the governed spawn topology; execution authority is enforced by the guard and reducer, not by this vocabulary. A closed enum here makes legitimate history unreadable without preventing anything.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "payload_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "technical_status": {
                "enum": ["PASS", "FAIL", "SKIPPED"]
              },
              "business_status": {
                "enum": ["PASS", "FAIL", "SKIPPED"]
              },
              "artifact_path": {
                "type": ["string", "null"],
                "minLength": 1,
                "maxLength": 1024
              },
              "artifacts": {
                "type": ["array", "null"],
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["logical_path", "sha256"],
                  "properties": {
                    "logical_path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              },
              "artifact_set_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "recorded_at": {
                "type": ["string", "null"],
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_ROOT_RESULT_RECORDED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/root_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_USER_QUESTION_RECORDED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "agent_id",
              "question",
              "session_key",
              "run_id"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "agent_id": {
                "description": "Open-world agent identity. The ledger records what executed, including ad-hoc identities outside the governed spawn topology; execution authority is enforced by the guard and reducer, not by this vocabulary. A closed enum here makes legitimate history unreadable without preventing anything.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "session_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_USER_ANSWER_RECORDED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "answer",
              "actor",
              "user_principal_ref",
              "message_id"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "actor": {
                "const": "user"
              },
              "user_principal_ref": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "message_id": {
                "type": "string",
                "pattern": "^[1-9][0-9]{16,19}$"
              },
              "thread_id": {
                "type": ["string", "null"],
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_TASK_RECONCILED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "actor",
              "reason_code",
              "node_id",
              "agent_id"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "actor": {
                "const": "main"
              },
              "reason_code": {
                "enum": ["TRANSIENT_RUNTIME_FAILURE", "RUN_TIMEOUT"]
              },
              "node_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "agent_id": {
                "description": "Open-world agent identity. The ledger records what executed, including ad-hoc identities outside the governed spawn topology; execution authority is enforced by the guard and reducer, not by this vocabulary. A closed enum here makes legitimate history unreadable without preventing anything.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_CANCELLED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "reason_code", "actor"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "reason_code": {
                "enum": ["OWNER_CANCELLED", "PARENT_CANCELLED"]
              },
              "actor": {
                "enum": ["user", "main"]
              },
              "channel": {
                "description": "M12/T9 F-030: the governed surface the cancellation was decided on. A cancellation that names a surface must name a REAL one: the provenance of an owner-cancel against a coordinator-cancel is otherwise unfalsifiable in the durable history, exactly as it is for every other verdict.",
                "enum": ["results", "approvals"]
              },
              "message_id": {
                "description": "M12/T9 F-030: the Discord message (snowflake) the cancellation was decided on. Same pattern as the pinned verdict siblings: a bare string accepted any fabricated id.",
                "type": ["string", "null"],
                "pattern": "^[1-9][0-9]{16,19}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_CONTINUATION_AUTHORIZED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "brief_revision",
              "session_key",
              "previous_run_id",
              "next_run_id",
              "source_session_key",
              "trigger_run_id"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "brief_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "session_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "previous_run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "next_run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source_session_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "trigger_run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "owner_attempt": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_CONTINUATION_STARTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "next_run_id",
              "session_key",
              "source_session_key",
              "agent_id"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "session_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "next_run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source_session_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "agent_id": {
                "description": "Open-world agent identity. The ledger records what executed, including ad-hoc identities outside the governed spawn topology; execution authority is enforced by the guard and reducer, not by this vocabulary. A closed enum here makes legitimate history unreadable without preventing anything.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "BUDGET_RESERVED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "kind", "amount", "counters"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "kind": {
                "enum": ["revisions", "transitions", "delegated_runs"]
              },
              "amount": {
                "type": "integer",
                "minimum": 1
              },
              "counters": {
                "$ref": "#/$defs/counters"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TASK_CREATED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "DELEGATION_RESERVED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_USER_RESULT_ACCEPTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "actor", "channel", "decision"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "actor": {
                "const": "user"
              },
              "channel": {
                "const": "results"
              },
              "decision": {
                "const": "ACCEPT"
              },
              "outcome_status": {
                "description": "F-226: the outcome the owner accepted. The post-ACCEPT workflow status is DERIVED from it, so a FAILED or PARTIAL run can never become a COMPLETE task because a button was clicked. It must equal the outcome the ledger recorded for the pending result.",
                "type": ["string", "null"],
                "enum": ["COMPLETE", "PARTIAL", "BLOCKED", "FAILED", null]
              },
              "result_id": {
                "type": ["string", "null"],
                "maxLength": 128
              },
              "result_digest": {
                "type": ["string", "null"],
                "pattern": "^[a-f0-9]{64}$"
              },
              "message_id": {
                "type": ["string", "null"],
                "pattern": "^[1-9][0-9]{16,19}$"
              },
              "thread_id": {
                "type": ["string", "null"],
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_USER_RESULT_REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "actor", "channel", "reason"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "actor": {
                "const": "user"
              },
              "channel": {
                "const": "results"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "result_id": {
                "type": ["string", "null"],
                "maxLength": 128
              },
              "result_digest": {
                "type": ["string", "null"],
                "pattern": "^[a-f0-9]{64}$"
              },
              "message_id": {
                "type": ["string", "null"],
                "pattern": "^[1-9][0-9]{16,19}$"
              },
              "thread_id": {
                "type": ["string", "null"],
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_USER_RESULT_BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "description": "Owner verdict: the owner reviewed the result and accepted BLOCKED as the authoritative final outcome. This is NOT an execution or reconciliation event; an execution event that merely produces a blocked condition (WORKFLOW_NATIVE_ENDED, a duplicate root result, a conflicting delegated result) must not be expressed as this verdict.",
            "additionalProperties": false,
            "required": ["task_id", "actor", "channel", "decision", "reason"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "actor": {
                "const": "user"
              },
              "channel": {
                "const": "results"
              },
              "decision": {
                "const": "BLOCK"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "reason_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "result_id": {
                "type": ["string", "null"],
                "maxLength": 128
              },
              "result_digest": {
                "type": ["string", "null"],
                "pattern": "^[a-f0-9]{64}$"
              },
              "message_id": {
                "type": ["string", "null"],
                "pattern": "^[1-9][0-9]{16,19}$"
              },
              "thread_id": {
                "type": ["string", "null"],
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_RESULT_REVISION_REQUESTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "actor", "channel", "feedback"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "actor": {
                "const": "user"
              },
              "channel": {
                "const": "results"
              },
              "feedback": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "result_id": {
                "type": ["string", "null"],
                "maxLength": 128
              },
              "result_digest": {
                "type": ["string", "null"],
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_APPROVAL_REQUESTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "agent_id", "session_key", "run_id"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "agent_id": {
                "type": "string",
                "minLength": 1
              },
              "session_key": {
                "description": "M7-041 attribution: the request is attributable to the run that owns the task, so the ledger records WHICH governed run surfaced the approval opportunity rather than trusting a caller or a UI payload.",
                "type": "string",
                "minLength": 1
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "brief_revision": {
                "description": "The brief revision this request refers to, when one is active. Purely audit context: the approval request and the execution brief are independent concepts and a request does NOT require a brief.",
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_APPROVAL_SURFACED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "channel", "thread_id"],
            "description": "M12/T2-R1: the approval request was actually surfaced to the owner, in the forum thread named here. This is the durable half of 'requested but never posted': without it a failed card post is invisible, a retry either loses the card or duplicates the thread, and a required-tag refusal cannot be re-driven. It is NOT a request (WORKFLOW_APPROVAL_REQUESTED) and NOT a decision (WORKFLOW_USER_APPROVAL_DECIDED).",
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "channel": {
                "const": "approvals"
              },
              "thread_id": {
                "description": "Discord thread snowflake the card lives in. Held as opaque text because it is external surface identity, not a governance identifier.",
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_RESULT_SURFACED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "channel", "thread_id"],
            "description": "M12/T2-R1: a governed result was surfaced in the #results forum as the thread named here. Before this event the results forum had no publish path at all, so nothing could prove a result was ever shown to the owner, and a retry had no way to avoid opening a second thread for the same result. NOT an owner verdict (WORKFLOW_USER_RESULT_*) and NOT a result record (WORKFLOW_ROOT_RESULT_RECORDED).",
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "channel": {
                "const": "results"
              },
              "thread_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "result_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_TASK_CLAIMED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "agent_id"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "agent_id": {
                "description": "Open-world agent identity. The ledger records what executed, including ad-hoc identities outside the governed spawn topology; execution authority is enforced by the guard and reducer, not by this vocabulary. A closed enum here makes legitimate history unreadable without preventing anything.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_COORDINATOR_RUN_BOUND"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "coordinator",
              "attempt",
              "lease_id",
              "session_key",
              "run_id"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "coordinator": {
                "description": "Designated coordinator. Only o1/o2 may coordinate executable work; the reducer enforces this independently of the schema vocabulary.",
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "lease_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "session_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WORKFLOW_USER_APPROVAL_DECIDED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "actor", "channel", "decision"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
              },
              "actor": {
                "const": "user"
              },
              "channel": {
                "enum": ["approvals", "results"]
              },
              "decision": {
                "enum": [
                  "APPROVE",
                  "REJECT",
                  "REQUEST_REVISION",
                  "ACCEPT",
                  "REJECT_RESULT",
                  "REQUEST_REVISION_RESULT"
                ]
              },
              "message_id": {
                "type": ["string", "null"],
                "pattern": "^[1-9][0-9]{16,19}$"
              },
              "thread_id": {
                "type": ["string", "null"],
                "maxLength": 256
              },
              "scope_digest": {
                "description": "F-023: the digest of the PLAN the owner approved (canonical.mjs deriveApprovalPlanDigest over the task's brief revision and node graph). It is what binds the consent to the work that runs: a digest that does not match the recorded plan is refused. NULL is accepted only for an approval recorded before the binding existed; a new approval must carry it.",
                "type": ["string", "null"],
                "pattern": "^[a-f0-9]{64}$"
              },
              "brief_revision": {
                "description": "F-023: the brief revision the owner approved. It must still be the task's current revision, so an approval issued for a superseded plan cannot transition the task.",
                "type": ["integer", "null"],
                "minimum": 1
              },
              "reason": {
                "type": ["string", "null"],
                "maxLength": 4096
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "parent_agent_id": {
      "description": "F-108: the agent that OWNS the delegation, i.e. the one that spawns the target. Declared ONCE here and referenced by every contract that carries it, so the ledger and the delegation envelope can never disagree about which values are legal: a reservation the ledger accepted must be a handoff the envelope accepts, and vice versa. Only main, o1 and o2 can spawn - the specialists have no spawn targets - so a specialist can never be a parent, and the reducer's own topology gate already refuses one.",
      "enum": ["main", "o1", "o2"]
    },
    "semantic_contract_status": {
      "enum": ["VALID", "MISSING", "AMBIGUOUS"]
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revisions_used", "transitions_used", "delegated_runs_used"],
      "properties": {
        "revisions_used": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "transitions_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "delegated_runs_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 72
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "agent_id",
        "stack_id",
        "dependencies",
        "required",
        "input_digest",
        "constraints_digest",
        "validation_digest"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "agent_id": {
          "description": "Open-world agent identity. The ledger records what executed, including ad-hoc identities outside the governed spawn topology; execution authority is enforced by the guard and reducer, not by this vocabulary. A closed enum here makes legitimate history unreadable without preventing anything.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "stack_id": {
          "enum": [
            "infrastructure",
            "data_plant",
            "semantic",
            "intelligence",
            "decision"
          ]
        },
        "dependencies": {
          "type": "array",
          "maxItems": 72,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "constraints_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validation_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "opened": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "origin",
        "origin_principal_ref",
        "origin_message_id",
        "root_agent_id",
        "root_session_key",
        "root_run_id"
      ],
      "properties": {
        "task_code": {
          "description": "M10/T2-R12: owner-facing 12-character code (8 date + 4 code characters). NOT required, so events already in the ledger replay byte-identically. Display alias only — never an authority token.",
          "type": "string",
          "pattern": "^[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
        },
        "origin": {
          "const": "discord"
        },
        "origin_principal_ref": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin_message_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{16,19}$"
        },
        "root_agent_id": {
          "enum": ["main", "o1", "o2", "excel", "power-bi", "sql", "python"]
        },
        "root_session_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "primary_coordinator": {
          "description": "F-057: the coordinator that owns this task's execution. OPTIONAL, so every event already in the ledger replays byte-identically, but REQUIRED for a task the pickup loop may claim: without it the ledger names no coordinator and the dispatch fails closed. Only o1/o2 are executable coordinators (main coordinates, the specialists execute).",
          "enum": ["o1", "o2"]
        },
        "root_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "reserved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "brief_revision",
        "node_id",
        "agent_id",
        "parent_agent_id",
        "parent_session_key",
        "parent_run_id",
        "tool_call_id",
        "turn",
        "attempt",
        "delegation_id",
        "expected_governance_hash",
        "request_digest"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
        },
        "brief_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "node_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "agent_id": {
          "description": "Open-world agent identity. The ledger records what executed, including ad-hoc identities outside the governed spawn topology; execution authority is enforced by the guard and reducer, not by this vocabulary. A closed enum here makes legitimate history unreadable without preventing anything.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "parent_agent_id": {
          "$ref": "#/$defs/parent_agent_id"
        },
        "parent_session_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "parent_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tool_call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "delegation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_governance_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "brief_revision",
        "session_key",
        "previous_run_id",
        "next_run_id",
        "source_session_key",
        "trigger_run_id"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
        },
        "brief_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "session_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "previous_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "next_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_session_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trigger_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "root_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "brief_revision",
        "native_run_id",
        "agent_id",
        "payload_digest",
        "outcome_status",
        "reason_code",
        "governance_hash"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|[0-9]{8}[CDEFHJKMNPQRTUVWXY379]{4})$"
        },
        "brief_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "native_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "agent_id": {
          "description": "Open-world agent identity. The ledger records what executed, including ad-hoc identities outside the governed spawn topology; execution authority is enforced by the guard and reducer, not by this vocabulary. A closed enum here makes legitimate history unreadable without preventing anything.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outcome_status": {
          "enum": ["COMPLETE", "PARTIAL", "BLOCKED", "FAILED"]
        },
        "reason_code": {
          "type": "string",
          "maxLength": 128
        },
        "governance_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pending_outcome_status": {
          "enum": ["COMPLETE", "PARTIAL", "BLOCKED", "FAILED"]
        }
      }
    }
  }
}
