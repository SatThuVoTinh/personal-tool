{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zink://contracts/ledger-event-v1",
  "title": "LedgerEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_version",
    "sequence",
    "type",
    "payload",
    "created_at",
    "previous_event_digest",
    "event_digest"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "governance_version": { "const": "m7-t2-r11" },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "maxLength": 128 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 64
    },
    "created_at": { "type": "string", "format": "date-time" },
    "previous_event_digest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
