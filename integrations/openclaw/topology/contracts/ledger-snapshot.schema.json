{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zink://contracts/ledger-snapshot-v1",
  "title": "LedgerSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_version",
    "sequence",
    "last_event_digest",
    "ingress_ids",
    "tasks",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "governance_version": { "const": "m7-t2-r11" },
    "sequence": { "type": "integer", "minimum": 0 },
    "last_event_digest": { "type": ["string", "null"] },
    "ingress_ids": {
      "type": "array",
      "maxItems": 2048,
      "items": { "type": "string", "maxLength": 128 }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 64
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
