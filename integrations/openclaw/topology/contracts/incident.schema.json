{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zink://contracts/incident-v1",
  "title": "IncidentV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_version",
    "incident_id",
    "task_id",
    "brief_revision",
    "run_id",
    "attempt",
    "detected_by",
    "category",
    "severity",
    "observed_state",
    "expected_state",
    "impact",
    "evidence",
    "containment_status",
    "recovery_status",
    "approval_required",
    "owner_action_required",
    "created_at",
    "publication_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "governance_version": {
      "enum": ["m7-t2-r12", "m7-t5-r13", "m8-t2-r9", "m8-t2.1-r3", "m8-t2.2-r4", "m8-t2.3-r5"]
    },
    "incident_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "task_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "brief_revision": { "type": "integer", "minimum": 1, "maximum": 16 },
    "run_id": { "type": "string", "maxLength": 256 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "detected_by": { "type": "string", "maxLength": 128 },
    "category": { "type": "string", "maxLength": 128 },
    "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "observed_state": { "type": "string", "maxLength": 4096 },
    "expected_state": { "type": "string", "maxLength": 4096 },
    "impact": { "type": "string", "maxLength": 4096 },
    "evidence": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "containment_status": { "type": "string", "maxLength": 1024 },
    "recovery_status": { "type": "string", "maxLength": 1024 },
    "approval_required": { "type": "boolean" },
    "owner_action_required": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" },
    "publication_status": { "const": "pending_owner_post" }
  }
}
