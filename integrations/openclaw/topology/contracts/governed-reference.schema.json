{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zink://contracts/governed-reference-v1",
  "title": "GovernedReferenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "governance_version",
    "ref_id",
    "ref_type",
    "producer_task_id",
    "producer_brief_revision",
    "producer_node_id",
    "producer_agent_id",
    "producer_run_id",
    "content_digest",
    "media_type",
    "size_bytes",
    "classification",
    "provenance",
    "validation_status",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "governance_version": {
      "enum": ["m7-t2-r12", "m7-t5-r13", "m8-t2-r9", "m8-t2.1-r3", "m8-t2.2-r4", "m8-t2.3-r5"]
    },
    "ref_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ref_type": { "type": "string", "maxLength": 128 },
    "producer_task_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "producer_brief_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "producer_node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "producer_agent_id": {
      "enum": ["main", "o1", "o2", "excel", "power-bi", "sql", "python"]
    },
    "producer_run_id": { "type": "string", "maxLength": 256 },
    "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "media_type": { "type": "string", "maxLength": 128 },
    "size_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
    "classification": { "enum": ["PUBLIC", "INTERNAL", "SENSITIVE_METADATA"] },
    "provenance": { "type": "string", "maxLength": 4096 },
    "validation_status": {
      "enum": ["PENDING", "VALID", "INVALID", "SUPERSEDED"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "imported_from_revision": { "type": "integer", "minimum": 1, "maximum": 16 }
  }
}
