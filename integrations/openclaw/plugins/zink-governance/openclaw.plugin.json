{
  "id": "zink-governance",
  "name": "Zink Governance",
  "description": "Model-invisible trusted governance guard for Zink T2 workflows.",
  "contracts": {
    "tools": [
      "zink_excel",
      "zink_knowledge_search",
      "zink_n8n",
      "zink_power_bi",
      "zink_python",
      "zink_skill_propose",
      "zink_skill_search",
      "zink_sql"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ledgerRoot": { "type": "string" },
      "ownerDiscordId": { "type": "string", "pattern": "^[1-9][0-9]{16,19}$" },
      "ownerPrincipalRef": { "type": "string" },
      "enabled": { "type": "boolean" }
    }
  }
}
