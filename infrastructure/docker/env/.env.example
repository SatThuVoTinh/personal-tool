# Copy to .env (ignored) before running the M2/T1 preflight.
# Do not use example values in a real runtime configuration.
MINIO_ROOT_USER=replace-with-a-unique-root-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-root-password
AISTOR_LICENSE_FILE=C:/absolute/path/outside-the-repository/minio.license
OLLAMA_SMOKE_MODEL=bge-m3:latest
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
N8N_POSTGRES_PASSWORD=replace-with-a-long-random-n8n-database-password
N8N_ENCRYPTION_KEY=replace-with-a-long-random-n8n-encryption-key
KNOWLEDGE_EMBEDDING_MODEL=bge-m3:latest
